msgstr "Acheter le marteau pour %d pièces ?"

#: u_resourcestring.sbuythestormcloud
#, object-pascal-format
msgid "Buy the Storm Cloud for %d coins?"
msgstr "Acheter la tempête d'éclairs foudroyants pour %d pièces?"

#: u_resourcestring.sbuyziplinefirst
msgid "you need to buy the zip line first!"
msgstr "vous devez tout d'abord acheter la tyrolienne !"

